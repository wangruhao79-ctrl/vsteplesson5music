      <!-- ANSWER KEY DRAWER (DISPLAYED ON DEMAND) -->
      <div id="act1AnswerKeyBox" style="display:none;margin-top:24px;background:rgba(13,148,136,0.1);border:1px solid rgba(13,148,136,0.35);border-radius:var(--radius-md);padding:22px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
          <h3 style="color:#2dd4bf;font-size:1.1rem;display:flex;align-items:center;gap:8px;">🎯 Bảng Đáp Án Chuẩn 6 Nhóm Từ Vựng (Answer Key)</h3>
          <span style="font-size:0.8rem;color:var(--text-muted);background:rgba(255,255,255,0.06);padding:3px 10px;border-radius:99px;">Đủ 26 Từ Vựng</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(270px, 1fr));gap:14px;">
