            <ul style="margin:0;padding-left:18px;color:#cbd5e1;font-size:0.86rem;line-height:1.6;">
              <li>Singer / Artist</li>
              <li>Celebrity</li>
              <li>Adoring fans</li>
              <li>A huge following</li>
            </ul>
          </div>
          <div style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:8px;padding:12px 14px;">
            <strong style="color:#fbbf24;font-size:0.92rem;display:block;margin-bottom:6px;">🎪 3. Music Events &amp; Performances (4 từ)</strong>
            <ul style="margin:0;padding-left:18px;color:#cbd5e1;font-size:0.86rem;line-height:1.6;">
