    const ACT1_CATEGORIES = [
      {id:"type-music",label:"🎼 Types of Music",cls:"cat-type-music",words:["Types of music","Ballad","Folk music / Traditional music","Classical music","Instrumental music"]},
      {id:"people",label:"👤 People in Music",cls:"cat-people",words:["Singer / Artist","Celebrity","Adoring fans","A huge following"]},
      {id:"events",label:"🎪 Music Events & Performances",cls:"cat-events",words:["Musical performance","Live concert","Music festival","Memorable concert"]},
      {id:"parts",label:"🎵 Parts & Features of a Song",cls:"cat-parts",words:["Meaningful lyrics","Chorus","Melody","A piece of music","Catchy tune","Massive hit / Big hit"]},
      {id:"prefs",label:"❤️ Music Preferences",cls:"cat-prefs",words:["Be a big fan of","Be into","Favourite genre","Taste in music","Prefer live to recorded music"]},
      {id:"feelings",label:"😌 Feelings & Benefits",cls:"cat-feelings",words:["Influence our emotions","Cheer sb up","Boost mood / Lift one's spirits","Relieve stress / Reduce anxiety","Unwind"]}
    ];

    // Build flat word→category map
    const WORD_TO_CAT = {};
    ACT1_CATEGORIES.forEach(cat => cat.words.forEach(w => { WORD_TO_CAT[w] = cat.id; }));
    const ALL_ACT1_WORDS = ACT1_CATEGORIES.flatMap(c => c.words);

    // ===== NAVIGATION =====
    function switchTab(tabId) {
      document.querySelectorAll('.tab-panel').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-tab').forEach(el => el.classList.remove('active'));
      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
      const btn = Array.from(document.querySelectorAll('.nav-tab')).find(b => b.getAttribute('onclick') && b.getAttribute('onclick').includes(tabId));
      if (btn) btn.classList.add('active');
    }

    // ===== WARM-UP GAME =====
    let currentTrackIdx = 0, score = 0, hasAnswered = false;
    const audioPlayer = document.getElementById('warmupAudioPlayer');
    const vinylRecord = document.getElementById('vinylRecord');
    const playBtnIcon = document.getElementById('playBtnIcon');
    const playBtnText = document.getElementById('playBtnText');

    function loadTrack(idx) {
      currentTrackIdx = idx; hasAnswered = false;
      const song = WARMUP_SONGS[idx];
      audioPlayer.src = song.preview; audioPlayer.pause();
      vinylRecord.classList.remove('playing');
      playBtnIcon.innerText = '▶️'; playBtnText.innerText = 'Nghe Đoạn Nhạc (30s)';
      document.getElementById('trackCountBadge').innerText = `Bài ${idx+1} / ${WARMUP_SONGS.length}`;
      document.getElementById('revealCard').style.display = 'none';
      const grid = document.getElementById('optionsGrid'); grid.innerHTML = '';
      const letters = ['A', 'B', 'C', 'D'];
      song.options.forEach((opt, oIdx) => {
        const btn = document.createElement('button');
        btn.className = 'opt-btn';
        btn.innerHTML = `<span class="opt-letter">${letters[oIdx]}</span> <span>${opt}</span>`;
        btn.onclick = () => selectOption(btn, opt, song);
        grid.appendChild(btn);
      });
      renderPlaylistBar();
    }

    function togglePlayPreview() {
      if (audioPlayer.paused) { audioPlayer.play(); vinylRecord.classList.add('playing'); playBtnIcon.innerText='⏸️'; playBtnText.innerText='Tạm Dừng'; }
      else { audioPlayer.pause(); vinylRecord.classList.remove('playing'); playBtnIcon.innerText='▶️'; playBtnText.innerText='Tiếp Tục Phát'; }
    }
    function replayPreview() { audioPlayer.currentTime=0; audioPlayer.play(); vinylRecord.classList.add('playing'); playBtnIcon.innerText='⏸️'; playBtnText.innerText='Tạm Dừng'; }
    function onAudioEnded() { vinylRecord.classList.remove('playing'); playBtnIcon.innerText='▶️'; playBtnText.innerText='Nghe Lại'; }

    function selectOption(btn, chosen, song) {
      if (hasAnswered) return; hasAnswered = true;
      const isCorrect = song.answer ? (chosen === song.answer) : (chosen.toLowerCase().includes(song.genre.split('/')[0].trim().toLowerCase()) || song.genre.toLowerCase().includes(chosen.toLowerCase()));
      document.querySelectorAll('.opt-btn').forEach((b, bIdx) => {
        b.disabled = true;
        const optVal = song.options[bIdx];
        const isOptCorrect = song.answer ? (optVal === song.answer) : (optVal.toLowerCase().includes(song.genre.split('/')[0].trim().toLowerCase()) || song.genre.toLowerCase().includes(optVal.toLowerCase()));
        if (isOptCorrect) b.classList.add('correct');
      });
      if (isCorrect) { btn.classList.add('correct'); score++; document.getElementById('gameScoreBadge').innerText=`Điểm: ${score} / ${WARMUP_SONGS.length}`; }
      else { btn.classList.add('wrong'); }
      const reveal = document.getElementById('revealCard');
      document.getElementById('revealArtwork').src = song.artwork;
      document.getElementById('revealTitle').innerText = song.title;
      document.getElementById('revealArtist').innerText = `Ca sĩ / Nghệ sĩ: ${song.artist}`;
      document.getElementById('revealGenre').innerText = `Thể loại: ${song.genre}`;
      document.getElementById('revealDesc').innerText = song.desc;
      reveal.style.display = 'block';
      renderPlaylistBar();
    }

    function nextTrack() {
      if (currentTrackIdx < WARMUP_SONGS.length - 1) loadTrack(currentTrackIdx + 1);
      else alert(`🎉 Chúc mừng! Điểm số: ${score} / ${WARMUP_SONGS.length}`);
    }
    function restartWarmupGame() { score=0; document.getElementById('gameScoreBadge').innerText=`Điểm: 0 / ${WARMUP_SONGS.length}`; loadTrack(0); }
    function renderPlaylistBar() {
      const bar = document.getElementById('playlistBar'); bar.innerHTML = '';
      WARMUP_SONGS.forEach((s,idx) => {
        const chip = document.createElement('button');
        chip.className = `playlist-chip ${idx===currentTrackIdx?'active':''}`;
        chip.innerText = `${idx+1}. ${s.title}`; chip.onclick = ()=>loadTrack(idx);
        bar.appendChild(chip);
      });
    }

    // ===== VOCAB TABLE =====
    function renderVocabTable() {
      const tbody = document.getElementById('vocabTableBody'); tbody.innerHTML = '';
      VOCAB_DATA.forEach(v => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td style="color:var(--text-muted);font-weight:700;">${v.id}</td><td><strong style="color:#fff;">${v.word}</strong> <span class="vocab-badge">${v.pos}</span></td><td style="color:var(--primary-light);font-family:monospace;">${v.ipa}</td><td style="color:var(--text-sub);font-weight:500;">${v.meaning}</td><td style="text-align:center;"><button class="btn btn-ghost" style="padding:3px 8px;font-size:0.8rem;" onclick="speakWord('${v.word.replace(/'/g,"\\'")}')">🔊</button></td>`;
        tbody.appendChild(tr);
      });
    }
    function filterVocabTable() {
      const q = document.getElementById('vocabSearchInput').value.toLowerCase();
      document.querySelectorAll('#vocabTableBody tr').forEach(row => { row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none'; });
    }
    function speakWord(text) { if ('speechSynthesis' in window) { window.speechSynthesis.cancel(); const u=new SpeechSynthesisUtterance(text); u.lang='en-US'; u.rate=0.9; window.speechSynthesis.speak(u); } }

    // ===== TAB 3: VOCAB CHALLENGE HELPERS =====
    let act1AnswersShown = false;
    function act1ToggleAnswers() {
      const btn = document.getElementById('act1ToggleAnsBtn');
      const keyBox = document.getElementById('act1AnswerKeyBox');
      if (!act1AnswersShown) {
        act1AnswersShown = true;
        if (btn) btn.innerText = '🙈 Ẩn Đáp Án / Tự Phân Loại';
        if (keyBox) keyBox.style.display = 'block';
        ACT1_CATEGORIES.forEach(cat => {
          const catContainer = document.getElementById(`catWords_${cat.id}`);
          if (catContainer) {
            catContainer.innerHTML = '';
            cat.words.forEach(w => {
              act1Placed[w] = cat.id;
              const chip = document.createElement('div');
              chip.className = `cat-word-chip ${cat.cls}`;
              chip.dataset.word = w;
              chip.style.outline = '2px solid #34d399';
              chip.innerHTML = `✔ ${w} <span style="opacity:0.6;font-size:0.75em;">↩</span>`;
              chip.title = 'Click để trả lại ô tổng hợp';
              const pill = document.querySelector(`.vocab-pill[data-word="${w.replace(/"/g,'\\"')}"]`);
              chip.onclick = () => act1ReturnWord(w, chip, pill);
              catContainer.appendChild(chip);
            });
          }
        });
        document.querySelectorAll('.vocab-pill').forEach(p => p.classList.add('placed'));
        document.getElementById('act1ScorePill').innerText = `✔ Đã hiển thị đáp án: ${ALL_ACT1_WORDS.length} / ${ALL_ACT1_WORDS.length}`;
        const msg = document.getElementById('act1ResultMsg');
        msg.innerText = '🎉 Đáp án chuẩn của 6 nhóm từ vựng Music!';
        msg.style.color = '#34d399';
      } else {
        act1Reset();
      }
    }

    // ===== TAB 5: EXPAND SHORT ANSWERS =====
    function renderExpandQuestions() {
      const container = document.getElementById('expandCardsContainer');
      if (!container) return;
      container.innerHTML = '';
      EXPAND_DATA.forEach(item => {
        const card = document.createElement('div');
        card.className = 'expand-card';
        card.id = `expCard_${item.id}`;
        card.innerHTML = `
          <div class="expand-header">
            <div class="expand-qtitle">${item.id}. ${item.question}</div>
            <div class="short-ans-pill">⚠️ Câu trả lời ngắn (3-4 từ): "<strong>${item.short}</strong>"</div>
          </div>
          <p class="expand-hint">💡 <em>${item.hint}</em></p>
          <textarea class="expand-textarea" id="expInput_${item.id}" placeholder="✍️ Nhập hoặc luyện nói câu trả lời mở rộng của bạn tại đây..."></textarea>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <button class="btn btn-primary" style="padding:6px 14px;font-size:0.84rem;" onclick="toggleExpandModel(${item.id})">
              <span id="expBtnIcon_${item.id}">👁️</span> <span id="expBtnText_${item.id}">Xem Mở Rộng Mẫu (B1 &amp; B2)</span>
            </button>
            <button class="btn btn-teal" style="padding:6px 14px;font-size:0.84rem;" onclick="triggerQuickTimer(45)">⏱️ Bấm Giờ Luyện Nói 45s</button>
          </div>
          <div class="expand-models-box" id="expModel_${item.id}">
            <div class="answers-comparison" style="margin-top:14px;">
              <div class="sample-box sample-b1">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                  <strong style="color:#2dd4bf;font-size:0.88rem;">Band B1 (Mở rộng tự nhiên, mạch lạc):</strong>
                  <button class="btn btn-ghost" style="padding:2px 8px;font-size:0.75rem;" onclick="speakWord(this.dataset.t)" data-t="${item.b1.replace(/"/g,'&quot;')}">🔊 Nghe</button>
                </div>
                <p style="color:var(--text-sub);line-height:1.55;font-size:0.92rem;">${item.b1}</p>
              </div>
              <div class="sample-box sample-b2">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                  <strong style="color:var(--primary-light);font-size:0.88rem;">Band B2 (Từ vựng phong phú, sâu sắc):</strong>
                  <button class="btn btn-ghost" style="padding:2px 8px;font-size:0.75rem;" onclick="speakWord(this.dataset.t)" data-t="${item.b2.replace(/"/g,'&quot;')}">🔊 Nghe</button>
                </div>
                <p style="color:var(--text-sub);line-height:1.55;font-size:0.92rem;">${item.b2}</p>
              </div>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function toggleExpandModel(id) {
      const box = document.getElementById(`expModel_${id}`);
      const icon = document.getElementById(`expBtnIcon_${id}`);
      const text = document.getElementById(`expBtnText_${id}`);
      if (!box) return;
      if (box.style.display === 'block') {
        box.style.display = 'none';
        if (icon) icon.innerText = '👁️';
        if (text) text.innerText = 'Xem Mở Rộng Mẫu (B1 & B2)';
      } else {
        box.style.display = 'block';
        if (icon) icon.innerText = '🙈';
        if (text) text.innerText = 'Ẩn Gợi Ý Mẫu';
      }
    }

    function showAllExpandModels() {
      EXPAND_DATA.forEach(item => {
        const box = document.getElementById(`expModel_${item.id}`);
        const icon = document.getElementById(`expBtnIcon_${item.id}`);
        const text = document.getElementById(`expBtnText_${item.id}`);
        if (box) box.style.display = 'block';
        if (icon) icon.innerText = '🙈';
        if (text) text.innerText = 'Ẩn Gợi Ý Mẫu';
      });
    }

    function hideAllExpandModels() {
      EXPAND_DATA.forEach(item => {
        const box = document.getElementById(`expModel_${item.id}`);
        const icon = document.getElementById(`expBtnIcon_${item.id}`);
        const text = document.getElementById(`expBtnText_${item.id}`);
        if (box) box.style.display = 'none';
        if (icon) icon.innerText = '👁️';
        if (text) text.innerText = 'Xem Mở Rộng Mẫu (B1 & B2)';
      });
    }

    function clearAllExpandInputs() {
      EXPAND_DATA.forEach(item => {
        const input = document.getElementById(`expInput_${item.id}`);
        if (input) input.value = '';
      });
    }

    // ===== ACTIVITY 1: BAY BAY VOCAB =====
    let act1Placed = {}; // word -> catId (or null)

    function act1Init() {
      act1Placed = {};
      // Render pool
      const pool = document.getElementById('act1Pool'); pool.innerHTML = '';
      const shuffled = [...ALL_ACT1_WORDS].sort(() => Math.random() - 0.5);
      shuffled.forEach((w, i) => {
        const pill = document.createElement('div');
        pill.className = 'vocab-pill'; pill.innerText = w;
        pill.style.animationDelay = (i * 0.05) + 's';
        pill.dataset.word = w;
        pill.onclick = () => act1PillClick(w, pill);
        pool.appendChild(pill);
      });
      // Render category boxes
      const grid = document.getElementById('act1CatGrid'); grid.innerHTML = '';
      ACT1_CATEGORIES.forEach(cat => {
        const box = document.createElement('div');
        box.className = `cat-box ${cat.cls}`; box.id = `catBox_${cat.id}`;
        box.innerHTML = `<div class="cat-box-title">${cat.label}</div><div class="cat-words" id="catWords_${cat.id}"></div>`;
        grid.appendChild(box);
      });
      act1UpdateScore();
      document.getElementById('act1ResultMsg').innerText = '';
    }

    function act1PillClick(word, pillEl) {
      if (act1Placed[word]) return; // already placed → ignore (click chip to return)
      // Prompt: which cat to place in? For simplicity, place into correct cat directly on click (educator mode) — or pick from a simple list
      // We'll use a modal-free approach: clicking shows a mini dropdown below
      act1ShowCatPicker(word, pillEl);
    }

    function act1ShowCatPicker(word, pillEl) {
      // Remove existing picker if any
      const old = document.getElementById('act1Picker'); if(old) old.remove();
      const picker = document.createElement('div');
      picker.id = 'act1Picker';
      picker.style.cssText = 'position:fixed;z-index:2000;background:#1e1b4b;border:1px solid var(--border-accent);border-radius:12px;padding:12px;box-shadow:0 12px 40px rgba(0,0,0,0.7);min-width:220px;';
      picker.innerHTML = `<div style="font-family:Outfit,sans-serif;font-size:0.78rem;color:var(--text-muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;">🗂️ Chọn nhóm cho "<strong style="color:#fff">${word}</strong>":</div>`;
      ACT1_CATEGORIES.forEach(cat => {
        const btn = document.createElement('button');
        btn.style.cssText = 'display:block;width:100%;text-align:left;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;padding:7px 12px;color:#fff;font-family:Outfit,sans-serif;font-size:0.82rem;cursor:pointer;margin-bottom:6px;transition:all 0.2s;';
        btn.innerText = cat.label;
        btn.onmouseenter = () => btn.style.background='rgba(139,92,246,0.25)';
        btn.onmouseleave = () => btn.style.background='rgba(255,255,255,0.04)';
        btn.onclick = (e) => { e.stopPropagation(); picker.remove(); act1PlaceWord(word, cat.id, pillEl); };
        picker.appendChild(btn);
      });
      const cancelBtn = document.createElement('button');
      cancelBtn.style.cssText = 'display:block;width:100%;text-align:center;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:5px 12px;color:#f87171;font-size:0.8rem;cursor:pointer;';
      cancelBtn.innerText = '✕ Huỷ'; cancelBtn.onclick = () => picker.remove();
      picker.appendChild(cancelBtn);
      document.body.appendChild(picker);
      const rect = pillEl.getBoundingClientRect();
      picker.style.top = Math.min(rect.bottom + 8, window.innerHeight - picker.offsetHeight - 20) + 'px';
      picker.style.left = Math.min(rect.left, window.innerWidth - 250) + 'px';
      setTimeout(() => document.addEventListener('click', function closePicker(ev) { if(!picker.contains(ev.target)){picker.remove();document.removeEventListener('click',closePicker);} }), 50);
    }

    function act1PlaceWord(word, catId, pillEl) {
      act1Placed[word] = catId;
      pillEl.classList.add('placed');
      // Add chip to category
      const catObj = ACT1_CATEGORIES.find(c => c.id === catId);
      const chip = document.createElement('div'); chip.className=`cat-word-chip ${catObj.cls}`; chip.dataset.word=word;
      chip.innerHTML = word + ' <span style="opacity:0.6;font-size:0.75em;">✕</span>';
      chip.title = 'Click để trả lại ô tổng hợp';
      chip.onclick = () => act1ReturnWord(word, chip, pillEl);
      document.getElementById(`catWords_${catId}`).appendChild(chip);
      act1UpdateScore();
    }

    function act1ReturnWord(word, chipEl, pillEl) {
      chipEl.remove();
      delete act1Placed[word];
      pillEl.classList.remove('placed');
      act1UpdateScore();
      document.getElementById('act1ResultMsg').innerText = '';
    }

    function act1UpdateScore() {
      const total = ALL_ACT1_WORDS.length;
      const placed = Object.keys(act1Placed).length;
      document.getElementById('act1ScorePill').innerText = `✔ Đã phân loại: ${placed} / ${total}`;
    }

    function act1CheckAll() {
      let correct=0, wrong=0;
      Object.entries(act1Placed).forEach(([word, placedCatId]) => {
        const correctCatId = WORD_TO_CAT[word];
        const chips = document.querySelectorAll(`#catWords_${placedCatId} .cat-word-chip`);
        chips.forEach(chip => {
          if(chip.dataset.word === word) {
            if(placedCatId === correctCatId) { correct++; chip.style.outline='2px solid #34d399'; }
            else { wrong++; chip.style.outline='2px solid #f87171'; }
          }
        });
      });
      const unplaced = ALL_ACT1_WORDS.length - Object.keys(act1Placed).length;
      let msg = `✅ Đúng: ${correct}  ❌ Sai: ${wrong}  ⬜ Chưa phân loại: ${unplaced}`;
      document.getElementById('act1ResultMsg').innerText = msg;
      document.getElementById('act1ResultMsg').style.color = wrong===0 && unplaced===0 ? '#34d399' : '#fbbf24';
    }

    function act1Reset() {
      act1AnswersShown = false;
      const btn = document.getElementById('act1ToggleAnsBtn');
      if (btn) btn.innerText = '👁️ Hiển Thị Đáp Án 6 Nhóm';
      const keyBox = document.getElementById('act1AnswerKeyBox');
      if (keyBox) keyBox.style.display = 'none';
      const chips = document.querySelectorAll('.cat-word-chip'); chips.forEach(c=>c.remove());
      act1Init();
    }

    // ===== ACTIVITY 2 HELPERS =====
    function toggleModel(id) {
      const box = document.getElementById(id);
      if (!box) return;
      box.classList.toggle('open');
    }
    function act2ShowAll() { document.querySelectorAll('.model-answer-box').forEach(b => b.classList.add('open')); }
    function act2HideAll() { document.querySelectorAll('.model-answer-box').forEach(b => b.classList.remove('open')); }
    function act2ClearAll() { document.querySelectorAll('.act2-textarea').forEach(t => t.value=''); }

    // ===== TIMER =====
    let timerSec=45, timerInterval=null;
    function formatTime(s) { const m=Math.floor(s/60),sec=s%60; return `${m<10?'0':''}${m}:${sec<10?'0':''}${sec}`; }
    function toggleFloatTimer() {
      const btn=document.getElementById('timerStartBtn'), disp=document.getElementById('floatTimerVal');
      if(timerInterval) { clearInterval(timerInterval); timerInterval=null; btn.innerText='▶️'; disp.classList.remove('active-run'); }
      else { btn.innerText='⏸️'; disp.classList.add('active-run'); timerInterval=setInterval(()=>{ if(timerSec>0){timerSec--;disp.innerText=formatTime(timerSec);}else{clearInterval(timerInterval);timerInterval=null;btn.innerText='▶️';disp.classList.remove('active-run');alert('⏰ Hết thời gian luyện nói!');}},1000); }
    }
    function resetFloatTimer() { if(timerInterval){clearInterval(timerInterval);timerInterval=null;} document.getElementById('timerStartBtn').innerText='▶️'; document.getElementById('floatTimerVal').classList.remove('active-run'); timerSec=45; document.getElementById('floatTimerVal').innerText='00:45'; }
    function triggerQuickTimer(seconds) { if(timerInterval){clearInterval(timerInterval);timerInterval=null;} timerSec=seconds; document.getElementById('floatTimerVal').innerText=formatTime(seconds); toggleFloatTimer(); }

    // ===== INIT =====
    window.onload = () => {
      loadTrack(0);
      renderVocabTable();
      act1Init();
      renderExpandQuestions();
    };
  </script>
</body>
</html>
