<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VSTEP Speaking Lesson 5: Music • Interactive Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-base: #090d16;
      --bg-surface: #111827;
      --bg-card: rgba(255,255,255,0.045);
      --border: rgba(255,255,255,0.10);
      --border-accent: rgba(139,92,246,0.45);
      --primary: #8b5cf6;
      --primary-light: #a78bfa;
      --secondary: #0d9488;
      --accent-pink: #ec4899;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-sub: #cbd5e1;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--bg-base);color:var(--text-main);min-height:100vh;line-height:1.6;overflow-x:hidden;}
    body::before{content:'';position:fixed;inset:0;z-index:-1;background:radial-gradient(circle 600px at 80% 10%,rgba(139,92,246,0.15),transparent 70%),radial-gradient(circle 500px at 15% 90%,rgba(13,148,136,0.12),transparent 70%);pointer-events:none;}
    h1,h2,h3,h4,h5,h6,.brand-title{font-family:'Outfit',sans-serif;font-weight:700;}
    .app-header{position:sticky;top:0;z-index:100;backdrop-filter:blur(24px);background:rgba(9,13,22,0.88);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;}
    .brand-group{display:flex;align-items:center;gap:14px;}
    .brand-logo-badge{background:linear-gradient(135deg,var(--primary),var(--accent-pink));color:#fff;font-family:'Outfit',sans-serif;font-weight:800;font-size:0.85rem;letter-spacing:1.5px;padding:6px 14px;border-radius:var(--radius-sm);text-transform:uppercase;}
    .brand-text h1{font-size:1.25rem;font-weight:800;background:linear-gradient(90deg,#ffffff 40%,var(--primary-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
    .btn{display:inline-flex;align-items:center;gap:8px;font-family:'Outfit',sans-serif;font-size:0.85rem;font-weight:600;padding:8px 16px;border-radius:var(--radius-sm);border:1px solid transparent;cursor:pointer;transition:var(--transition);text-decoration:none;color:#fff;}
    .btn-primary{background:linear-gradient(135deg,var(--primary),#7c3aed);box-shadow:0 4px 14px rgba(139,92,246,0.35);}
    .btn-teal{background:linear-gradient(135deg,var(--secondary),#0f766e);}
    .btn-ghost{background:rgba(255,255,255,0.06);border-color:var(--border);}
    .btn-ghost:hover{background:rgba(255,255,255,0.12);}
    .nav-bar-wrapper{background:rgba(17,24,39,0.95);border-bottom:1px solid var(--border);position:sticky;top:61px;z-index:90;backdrop-filter:blur(16px);overflow-x:auto;}
    .nav-tabs{max-width:1400px;margin:0 auto;display:flex;padding:0 20px;gap:4px;}
    .nav-tab{display:flex;align-items:center;gap:6px;padding:12px 14px;font-family:'Outfit',sans-serif;font-weight:600;font-size:0.82rem;color:var(--text-muted);border:none;background:none;cursor:pointer;border-bottom:3px solid transparent;transition:var(--transition);white-space:nowrap;}
    .nav-tab.active{color:var(--primary-light);border-bottom-color:var(--primary);background:rgba(139,92,246,0.08);}
    .tab-badge{font-size:0.7rem;padding:2px 7px;border-radius:99px;background:rgba(255,255,255,0.1);color:var(--text-sub);}
    .nav-tab.active .tab-badge{background:var(--primary);color:#fff;font-weight:700;}
    .main-content{max-width:1400px;margin:0 auto;padding:26px 20px 80px;}
    .tab-panel{display:none;}
    .tab-panel.active{display:block;}
    .section-hero{background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(13,148,136,0.08));border:1px solid var(--border-accent);border-radius:var(--radius-lg);padding:24px 28px;margin-bottom:24px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;}
    .hero-badge-tag{display:inline-block;font-size:0.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--primary-light);background:rgba(139,92,246,0.2);padding:3px 10px;border-radius:99px;margin-bottom:8px;}
    .card{background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-md);padding:24px;margin-bottom:20px;box-shadow:0 4px 20px rgba(0,0,0,0.25);}
    .warmup-game-container{max-width:900px;margin:0 auto;}
    .game-arena{background:linear-gradient(145deg,#181133,#0f172a);border:2px solid var(--border-accent);border-radius:var(--radius-lg);padding:30px;text-align:center;box-shadow:0 10px 40px rgba(139,92,246,0.2);}
    .audio-player-box{background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:var(--radius-md);padding:24px;margin:20px 0;display:flex;flex-direction:column;align-items:center;gap:16px;}
    .vinyl-record{width:120px;height:120px;border-radius:50%;background:radial-gradient(circle,#2d1b69 15%,#0f0a24 16%,#0f0a24 35%,#1a103c 36%,#1a103c 55%,#090616 56%);border:4px solid rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;box-shadow:0 0 25px rgba(139,92,246,0.4);animation:spinVinyl 4s linear infinite;animation-play-state:paused;}
    .vinyl-record.playing{animation-play-state:running;}
    @keyframes spinVinyl{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
    .vinyl-center{width:44px;height:44px;border-radius:50%;background:var(--primary);border:3px solid #fff;display:flex;align-items:center;justify-content:center;font-size:1.2rem;}
    .guess-options-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0;}
    .opt-btn{background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:var(--radius-md);padding:16px;font-family:'Outfit',sans-serif;font-size:1.1rem;font-weight:600;color:#fff;cursor:pointer;transition:var(--transition);display:flex;align-items:center;justify-content:center;}
    .opt-letter{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.1);color:var(--primary-light);font-size:0.95rem;font-weight:700;margin-right:10px;flex-shrink:0;transition:var(--transition);}
    .opt-btn:hover:not(:disabled){background:rgba(139,92,246,0.2);border-color:var(--primary);transform:translateY(-2px);}
    .opt-btn.correct{background:rgba(16,185,129,0.25)!important;border-color:#10b981!important;color:#34d399!important;}
    .opt-btn.correct .opt-letter{background:rgba(16,185,129,0.35);color:#34d399;}
    .opt-btn.wrong{background:rgba(239,68,68,0.2)!important;border-color:#ef4444!important;color:#f87171!important;}
    .opt-btn.wrong .opt-letter{background:rgba(239,68,68,0.35);color:#f87171;}
    .reveal-card{display:none;background:rgba(13,148,136,0.15);border:1px solid rgba(13,148,136,0.4);border-radius:var(--radius-md);padding:20px;margin-top:20px;}
    .playlist-bar{display:flex;gap:8px;overflow-x:auto;padding:12px 4px;margin-top:20px;}
    .playlist-chip{padding:8px 16px;border-radius:99px;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--text-muted);cursor:pointer;white-space:nowrap;font-size:0.82rem;font-weight:600;}
    .playlist-chip.active{background:var(--primary);color:#fff;border-color:var(--primary-light);}
    .vocab-table{width:100%;border-collapse:collapse;margin-top:10px;}
    .vocab-table th{background:rgba(255,255,255,0.06);padding:12px 14px;text-align:left;font-family:'Outfit',sans-serif;font-size:0.8rem;font-weight:700;text-transform:uppercase;color:var(--text-sub);border-bottom:1px solid var(--border);}
    .vocab-table td{padding:12px 14px;border-bottom:1px solid rgba(255,255,255,0.05);font-size:0.9rem;}
    .vocab-badge{display:inline-block;font-size:0.72rem;font-weight:700;padding:1px 6px;border-radius:4px;margin-left:6px;background:rgba(139,92,246,0.2);color:var(--primary-light);}
    .q-item{background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:var(--radius-sm);margin-bottom:12px;overflow:hidden;transition:var(--transition);}
    .q-header{padding:16px 20px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;}
    .q-body{display:none;padding:0 20px 20px;border-top:1px solid rgba(255,255,255,0.05);background:rgba(0,0,0,0.25);}
    .q-item.open .q-body{display:block;padding-top:18px;}
    .answers-comparison{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px;}
    @media(max-width:768px){.answers-comparison{grid-template-columns:1fr;}.guess-options-grid{grid-template-columns:1fr;}}
    .sample-box{border-radius:var(--radius-sm);padding:14px 16px;font-size:0.92rem;}
    .sample-b1{background:rgba(13,148,136,0.1);border:1px solid rgba(13,148,136,0.3);}
    .sample-b2{background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.3);}
    .floating-timer{position:fixed;bottom:24px;right:24px;z-index:1000;background:rgba(17,24,39,0.95);backdrop-filter:blur(20px);border:1px solid var(--border-accent);border-radius:var(--radius-lg);padding:10px 18px;box-shadow:0 10px 40px rgba(0,0,0,0.6);display:flex;align-items:center;gap:12px;}
    .timer-display{font-family:'Outfit',sans-serif;font-size:1.7rem;font-weight:800;color:#fff;}
    .timer-display.active-run{color:var(--primary-light);}

    /* ===== ACTIVITY 1: BAY BAY VOCAB ===== */
    .act1-pool-area{background:rgba(0,0,0,0.3);border:2px dashed var(--border-accent);border-radius:var(--radius-lg);padding:20px;margin-bottom:24px;min-height:100px;display:flex;flex-wrap:wrap;gap:10px;align-content:flex-start;}
    .vocab-pill{display:inline-flex;align-items:center;padding:8px 16px;border-radius:99px;background:linear-gradient(135deg,rgba(139,92,246,0.25),rgba(236,72,153,0.15));border:1px solid rgba(139,92,246,0.5);color:#fff;font-family:'Outfit',sans-serif;font-size:0.88rem;font-weight:600;cursor:pointer;transition:var(--transition);user-select:none;animation:floatIn 0.5s ease both;}
    .vocab-pill:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 6px 20px rgba(139,92,246,0.4);background:linear-gradient(135deg,rgba(139,92,246,0.5),rgba(236,72,153,0.3));}
    .vocab-pill.placed{opacity:0.5;cursor:default;animation:none;transform:none;}
    @keyframes floatIn{from{opacity:0;transform:translateY(20px) scale(0.9);}to{opacity:1;transform:translateY(0) scale(1);}}
    .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:8px;}
    @media(max-width:900px){.cat-grid{grid-template-columns:repeat(2,1fr);}}
    @media(max-width:580px){.cat-grid{grid-template-columns:1fr;}}
    .cat-box{background:var(--bg-surface);border:2px solid var(--border);border-radius:var(--radius-md);padding:16px;min-height:120px;transition:var(--transition);position:relative;}
    .cat-box.highlight{border-color:var(--primary-light);background:rgba(139,92,246,0.08);}
    .cat-box-title{font-family:'Outfit',sans-serif;font-size:0.78rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;padding:4px 10px;border-radius:99px;display:inline-block;}
    .cat-type-music .cat-box-title{background:rgba(14,165,233,0.2);color:#38bdf8;}
    .cat-people .cat-box-title{background:rgba(236,72,153,0.2);color:#f472b6;}
    .cat-events .cat-box-title{background:rgba(245,158,11,0.2);color:#fbbf24;}
    .cat-parts .cat-box-title{background:rgba(16,185,129,0.2);color:#34d399;}
    .cat-prefs .cat-box-title{background:rgba(139,92,246,0.2);color:#a78bfa;}
    .cat-feelings .cat-box-title{background:rgba(239,68,68,0.2);color:#f87171;}
    .cat-words{display:flex;flex-wrap:wrap;gap:6px;}
    .cat-word-chip{display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:99px;font-size:0.8rem;font-weight:600;border:1px solid;cursor:pointer;transition:var(--transition);}
    .cat-word-chip:hover{transform:scale(1.05);}
    .cat-type-music .cat-word-chip{background:rgba(14,165,233,0.15);border-color:rgba(14,165,233,0.4);color:#7dd3fc;}
    .cat-people .cat-word-chip{background:rgba(236,72,153,0.15);border-color:rgba(236,72,153,0.4);color:#f9a8d4;}
    .cat-events .cat-word-chip{background:rgba(245,158,11,0.15);border-color:rgba(245,158,11,0.4);color:#fcd34d;}
    .cat-parts .cat-word-chip{background:rgba(16,185,129,0.15);border-color:rgba(16,185,129,0.4);color:#6ee7b7;}
    .cat-prefs .cat-word-chip{background:rgba(139,92,246,0.15);border-color:rgba(139,92,246,0.4);color:#c4b5fd;}
    .cat-feelings .cat-word-chip{background:rgba(239,68,68,0.15);border-color:rgba(239,68,68,0.4);color:#fca5a5;}
    .act1-score-bar{display:flex;align-items:center;gap:16px;margin-bottom:16px;flex-wrap:wrap;}
    .act1-score-pill{background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.4);color:#34d399;font-weight:700;padding:6px 16px;border-radius:99px;font-family:'Outfit',sans-serif;font-size:0.9rem;}

    /* ===== ACTIVITY 2: LEVELED QUESTIONS ===== */
    .level-section{margin-bottom:32px;}
    .level-header{display:flex;align-items:center;gap:12px;margin-bottom:16px;padding:12px 20px;border-radius:var(--radius-md);}
    .level-1 .level-header{background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(6,182,212,0.08));border:1px solid rgba(16,185,129,0.3);}
    .level-2 .level-header{background:linear-gradient(135deg,rgba(245,158,11,0.15),rgba(251,191,36,0.08));border:1px solid rgba(245,158,11,0.3);}
    .level-3 .level-header{background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(236,72,153,0.08));border:1px solid rgba(139,92,246,0.3);}
    .level-badge{font-family:'Outfit',sans-serif;font-weight:800;font-size:0.8rem;text-transform:uppercase;padding:4px 12px;border-radius:99px;letter-spacing:1px;}
    .level-1 .level-badge{background:rgba(16,185,129,0.3);color:#34d399;}
    .level-2 .level-badge{background:rgba(245,158,11,0.3);color:#fbbf24;}
    .level-3 .level-badge{background:rgba(139,92,246,0.3);color:#a78bfa;}
    .act2-qcard{background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:var(--radius-md);padding:20px;margin-bottom:14px;transition:var(--transition);}
    .act2-qcard:hover{border-color:rgba(139,92,246,0.3);}
    .act2-qnum{font-family:'Outfit',sans-serif;font-size:0.75rem;font-weight:800;text-transform:uppercase;color:var(--text-muted);margin-bottom:6px;}
    .act2-question{font-size:1.05rem;font-weight:700;color:#fff;margin-bottom:10px;}
    .keywords-row{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;}
    .kw-pill{padding:3px 10px;border-radius:99px;font-size:0.78rem;font-weight:600;background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.3);color:var(--primary-light);}
    .act2-textarea{width:100%;background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 14px;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;resize:vertical;min-height:70px;outline:none;transition:var(--transition);}
    .act2-textarea:focus{border-color:var(--primary-light);box-shadow:0 0 0 3px rgba(139,92,246,0.15);}
    .act2-textarea::placeholder{color:var(--text-muted);}
    .show-model-btn{margin-top:10px;font-size:0.8rem;padding:5px 14px;}
    .model-answer-box{display:none;margin-top:10px;padding:12px 16px;border-radius:var(--radius-sm);font-size:0.9rem;line-height:1.65;}
    .level-1 .model-answer-box{background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);color:#a7f3d0;}
    .level-2 .model-answer-box{background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);color:#fde68a;}
    .level-3 .model-answer-box{background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.25);color:#ddd6fe;}
    .model-answer-box.open{display:block;animation:fadeSlide 0.3s ease;}
    @keyframes fadeSlide{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:translateY(0);}}
    .highlight-kw{background:rgba(139,92,246,0.25);border-radius:3px;padding:0 2px;font-weight:700;}
    .act2-controls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;}

    /* ===== TAB 5: EXPAND SHORT ANSWERS ===== */
    .expand-card{background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:var(--radius-md);padding:22px;margin-bottom:20px;box-shadow:0 4px 20px rgba(0,0,0,0.25);transition:var(--transition);}
    .expand-card:hover{border-color:rgba(139,92,246,0.35);}
    .expand-header{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px;flex-wrap:wrap;}
    .expand-qtitle{font-size:1.1rem;font-weight:700;color:#fff;}
    .short-ans-pill{display:inline-flex;align-items:center;gap:6px;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.35);color:#fca5a5;padding:6px 14px;border-radius:99px;font-size:0.85rem;font-weight:600;}
    .expand-hint{font-size:0.86rem;color:var(--text-muted);margin-bottom:12px;line-height:1.5;}
    .expand-textarea{width:100%;min-height:75px;background:rgba(0,0,0,0.35);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 14px;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:0.92rem;line-height:1.5;resize:vertical;margin-bottom:12px;}
    .expand-textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(139,92,246,0.2);}
    .expand-models-box{display:none;margin-top:14px;border-radius:var(--radius-sm);overflow:hidden;}
    .formula-bar{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px;}
    @media(max-width:768px){.formula-bar{grid-template-columns:1fr;}}
    .formula-step{background:rgba(255,255,255,0.03);border:1px solid var(--border-accent);border-radius:var(--radius-sm);padding:14px 18px;}
    .formula-step-num{font-size:0.75rem;font-weight:700;color:var(--primary-light);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;}
    .formula-step-title{font-size:0.95rem;font-weight:700;color:#fff;margin-bottom:4px;}
    .formula-step-desc{font-size:0.82rem;color:var(--text-muted);line-height:1.4;}
  </style>
</head>
<body>
  <header class="app-header">
    <div class="brand-group">
      <div class="brand-logo-badge">VSTEP SPEAKING</div>
      <div class="brand-text">
        <h1>Lesson 5: Music • Trendy Vietnam Warm-up &amp; Masterclass</h1>
      </div>
    </div>
    <div class="header-actions" style="display:flex;gap:8px;flex-wrap:wrap;">
      <a href="Lesson 5_Handout_A4.html" target="_blank" class="btn btn-primary">📄 In Handout A4 (4 Trang)</a>
      <a href="Lesson 5_Activity_2_Handout_A4.html" target="_blank" class="btn btn-teal">🎯 Interactive Activity 2 (15 Câu)</a>
      <button class="btn btn-ghost" onclick="triggerQuickTimer(45)">⏱️ Timer 45s</button>
    </div>
  </header>

  <div class="nav-bar-wrapper">
    <nav class="nav-tabs">
      <button class="nav-tab active" onclick="switchTab('tab-warmup')">
        <span>🎵 1. Warm-up Đoán Nhạc</span>
        <span class="tab-badge">10 Bài</span>
      </button>
      <button class="nav-tab" onclick="switchTab('tab-recycle')">
        <span>🔄 2. Recycle 32 Từ</span>
        <span class="tab-badge">32 Từ</span>
      </button>
      <button class="nav-tab" onclick="switchTab('tab-act1')">
        <span>🎮 3. Vocab Challenge</span>
        <span class="tab-badge">6 Nhóm</span>
      </button>
      <button class="nav-tab" onclick="switchTab('tab-act2')">
        <span>📝 4. Make A Complete Answer</span>
        <span class="tab-badge">15 Câu</span>
      </button>
      <button class="nav-tab" onclick="switchTab('tab-expand')">
        <span>🚀 5. Expand Short Answers</span>
        <span class="tab-badge">8 Câu</span>
      </button>
    </nav>
  </div>

  <main class="main-content">

    <!-- TAB 1: WARM UP -->
    <section id="tab-warmup" class="tab-panel active">
      <div class="section-hero">
        <div class="hero-info">
          <span class="hero-badge-tag">Interactive Warm-up Game</span>
          <h2>🎧 Game Đoán Nhạc: Name That Tune &amp; Music Genre</h2>
          <p>Lắng nghe đoạn nhạc ngắn 30s từ các bản hit cực trendy tại Việt Nam. Đoán thể loại âm nhạc để kích hoạt từ vựng bài học!</p>
        </div>
        <div class="hero-actions">
          <button class="btn btn-primary" onclick="restartWarmupGame()">🔄 Bắt Đầu Lại</button>
        </div>
      </div>
      <div class="warmup-game-container">
        <div class="game-arena">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span id="trackCountBadge" style="font-size:0.85rem;font-weight:700;color:var(--primary-light);text-transform:uppercase;">Bài 1 / 10</span>
            <span id="gameScoreBadge" style="font-size:0.85rem;font-weight:700;color:#34d399;background:rgba(16,185,129,0.15);padding:4px 12px;border-radius:99px;">Điểm: 0 / 10</span>
          </div>
          <div class="audio-player-box">
            <div class="vinyl-record" id="vinylRecord"><div class="vinyl-center">🎵</div></div>
            <audio id="warmupAudioPlayer" preload="auto" onended="onAudioEnded()"></audio>
            <div style="display:flex;gap:10px;align-items:center;margin-top:10px;">
              <button class="btn btn-primary" id="playBtn" style="padding:10px 24px;font-size:1rem;border-radius:99px;" onclick="togglePlayPreview()">
                <span id="playBtnIcon">▶️</span> <span id="playBtnText">Nghe Đoạn Nhạc (30s)</span>
              </button>
              <button class="btn btn-ghost" style="border-radius:99px;" onclick="replayPreview()">🔁 Nghe Lại</button>
            </div>
          </div>
          <h3 style="font-size:1.15rem;color:#fff;margin-bottom:6px;">❓ Thể loại âm nhạc (Genre) của bài hát này là gì?</h3>
          <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:16px;">Hãy lắng nghe giai điệu và chọn đáp án chính xác:</p>
          <div class="guess-options-grid" id="optionsGrid"></div>
          <div class="reveal-card" id="revealCard">
            <div style="display:flex;align-items:center;gap:16px;text-align:left;">
              <img id="revealArtwork" src="" alt="Artwork" style="width:72px;height:72px;border-radius:8px;border:1px solid var(--border);" />
              <div>
                <h4 id="revealTitle" style="font-size:1.25rem;color:#fff;margin-bottom:2px;"></h4>
                <p id="revealArtist" style="font-size:0.95rem;color:var(--primary-light);font-weight:600;margin-bottom:4px;"></p>
                <p id="revealGenre" style="font-size:0.85rem;color:#34d399;font-weight:700;margin-bottom:4px;"></p>
                <p id="revealDesc" style="font-size:0.82rem;color:var(--text-sub);font-style:italic;"></p>
              </div>
            </div>
            <div style="margin-top:14px;text-align:right;">
              <button class="btn btn-teal" onclick="nextTrack()">Bài Tiếp Theo ➡️</button>
            </div>
          </div>
          <div class="playlist-bar" id="playlistBar"></div>
        </div>
      </div>
    </section>

